{
  "info": {
    "name": "Student Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminToken", "value": "" },
    { "key": "studentToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/admin/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"<ADMIN_PASSWORD>\"\n}"
            }
          }
        },
        {
          "name": "Student Validate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/student/validate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentCode\": \"STU-1001\",\n  \"dateOfBirth\": \"2008-05-20\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admit Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"dateOfBirth\": \"2008-05-20\",\n  \"gender\": \"Female\",\n  \"studentCode\": \"STU-1001\",\n  \"email\": \"jane@example.com\",\n  \"addresses\": [\n    {\"type\": \"PERMANENT\", \"addressLine\": \"12 MG Road\", \"city\": \"Bengaluru\", \"country\": \"India\"}\n  ]\n}"
            }
          }
        },
        {
          "name": "Search Students By Name",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/students/search?name=Jane"
          }
        },
        {
          "name": "Create Course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/api/admin/courses",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Data Structures\",\n  \"description\": \"Intro to DSA\",\n  \"courseType\": \"Core\",\n  \"duration\": \"8 weeks\",\n  \"topics\": [\"Arrays\", \"Trees\", \"Graphs\"]\n}"
            }
          }
        },
        {
          "name": "List Courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/courses"
          }
        },
        {
          "name": "Assign Course To Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/students/1/courses/1"
          }
        },
        {
          "name": "Get Students By Course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/admin/courses/1/students"
          }
        }
      ]
    },
    {
      "name": "Student",
      "item": [
        {
          "name": "Get Own Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/students/me/profile"
          }
        },
        {
          "name": "Update Own Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{studentToken}}" }
            ],
            "url": "{{baseUrl}}/api/students/me/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.new@example.com\",\n  \"mobileNumber\": \"9876543210\"\n}"
            }
          }
        },
        {
          "name": "Leave Course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/students/me/courses/1"
          }
        }
      ]
    }
  ]
}
